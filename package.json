{
  "name": "ticket-open-alert",
  "version": "0.1.0",
  "private": true,
  "description": "개인용 티켓 예매 오픈 알림 크롬 확장 프로그램 (Manifest V3)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "serve:test-page": "node scripts/serve-test-page.mjs",
    "test": "npm run typecheck && npm run build && npm run build:test && playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "npm run build:test && playwright test --project=e2e",
    "dev:browser": "node scripts/launch-dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
